[mysqld]
server-id                 = 2
log_bin                   = mysql-bin
binlog_format             = ROW
binlog_row_image          = FULL
log_replica_updates       = ON
gtid_mode                 = ON
enforce_gtid_consistency  = ON
read_only                 = ON
relay_log                 = mysql-relay-bin
binlog_expire_logs_seconds = 86400
